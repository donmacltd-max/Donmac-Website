# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.donmacltd.com

# ---------- Enquiry email (SMTP) ----------
# Microsoft 365: smtp.office365.com, port 587. Google Workspace: smtp.gmail.com, port 587 (use an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Donmac Website <no-reply@donmacltd.com>"
ENQUIRY_SEND_ACK=true            # send an acknowledgement with reference number to the enquirer

# ---------- Enquiry routing (one address or comma-separated list) ----------
ENQUIRY_TO_DEFAULT=sales@donmacltd.com
ENQUIRY_TO_ENERGY=
ENQUIRY_TO_ICT=
ENQUIRY_TO_E_MOBILITY=
ENQUIRY_TO_SOURCING=
ENQUIRY_TO_CONSTRUCTION=
ENQUIRY_TO_TELECOMMUNICATIONS=
ENQUIRY_TO_GENERAL=info@donmacltd.com
ENQUIRY_TO_PARTNERSHIPS=
ENQUIRY_TO_CAREERS=

# ---------- Enquiry tracking ----------
# POST each enquiry (JSON, no attachments) to a CRM, Zapier/Make hook or Google Apps Script
ENQUIRY_WEBHOOK_URL=
# Local JSONL log directory ("off" to disable). Use a persistent volume on VPS hosting.
ENQUIRY_LOG_DIR=

# ---------- Spam protection (Cloudflare Turnstile, free) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- CMS login (GitHub OAuth app for Decap CMS) ----------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---------- Privacy-friendly analytics (optional) ----------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
